---
import ProjectRow from './ProjectRow.astro';
import { projectCategories, type ProjectCategory } from '@/config/categories';
import type { Project } from '@/utils/content';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

// Only offer filters for categories that actually contain projects.
const categories = (Object.keys(projectCategories) as ProjectCategory[]).filter((key) =>
  projects.some((p) => p.data.category === key),
);

const filters = [
  { key: 'all', label: 'All', count: projects.length },
  ...categories.map((key) => ({
    key,
    label: projectCategories[key],
    count: projects.filter((p) => p.data.category === key).length,
  })),
];
---

<div data-project-browser>
  <div
    role="group"
    aria-label="Filter projects by category"
    class="-mx-1 flex flex-wrap gap-2 px-1 pb-8"
  >
    {filters.map((filter) => (
      <button
        type="button"
        data-filter={filter.key}
        aria-pressed={filter.key === 'all' ? 'true' : 'false'}
        class="filter-button border-line text-muted hover:border-ink hover:text-ink inline-flex min-h-11 items-center gap-2 rounded-full border px-4 text-sm transition-colors"
      >
        {filter.label}
        <span class="font-mono text-xs opacity-70" aria-hidden="true">
          {filter.count}
        </span>
      </button>
    ))}
  </div>

  <p class="sr-only" role="status" aria-live="polite" data-filter-status></p>

  <ul class="project-list border-line border-t">
    {projects.map((project) => (
      <ProjectRow project={project} />
    ))}
  </ul>
</div>

<style>
  .filter-button[aria-pressed='true'] {
    background-color: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }

  /* CSS counters skip hidden rows, so numbering stays sequential when filtered. */
  .project-list {
    counter-reset: project;
  }
  .project-list :global(.project-row) {
    counter-increment: project;
  }
  .project-list :global(.project-index)::before {
    content: counter(project, decimal-leading-zero);
  }
</style>

<script>
  const browser = document.querySelector<HTMLElement>('[data-project-browser]');

  if (browser) {
    const buttons = [...browser.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const rows = [...browser.querySelectorAll<HTMLElement>('[data-project]')];
    const status = browser.querySelector<HTMLElement>('[data-filter-status]');
    const valid = new Set(buttons.map((b) => b.dataset.filter));

    const apply = (category: string, announce: boolean) => {
      let visible = 0;
      rows.forEach((row) => {
        const show = category === 'all' || row.dataset.category === category;
        row.hidden = !show;
        if (show) visible += 1;
      });

      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === category)));

      if (announce && status) {
        const label = buttons.find((b) => b.dataset.filter === category)?.firstChild?.textContent;
        status.textContent = `Showing ${visible} ${visible === 1 ? 'project' : 'projects'}${
          category === 'all' ? '' : ` in ${label?.trim()}`
        }.`;
      }
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const category = button.dataset.filter ?? 'all';
        apply(category, true);

        const url = new URL(window.location.href);
        if (category === 'all') url.searchParams.delete('category');
        else url.searchParams.set('category', category);
        history.replaceState(null, '', url);
      });
    });

    // Support shareable links such as /projects/?category=backend
    const initial = new URLSearchParams(window.location.search).get('category');
    if (initial && valid.has(initial)) apply(initial, false);
  }
</script>
