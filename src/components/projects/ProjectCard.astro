---
/**
 * A single project card: visual placeholder, status, title, one or two
 * lines of description, category, tech tags and the GitHub / live links.
 * There is no project page — the card is the whole story.
 */
import Button from '@/components/ui/Button.astro';
import TagList from '@/components/ui/TagList.astro';
import { projectCategories } from '@/config/categories';
import type { Project } from '@/config/projects';
import { isShown } from '@/utils/links';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, category, tech, status, github, demo } = project;

const statusMeta = {
  live: { label: 'Live', dot: 'bg-live' },
  building: { label: 'Building', dot: 'bg-building' },
  planned: { label: 'Planned', dot: 'bg-planned' },
} as const;

const initials = title
  .split(/[\s&-]+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w.charAt(0).toUpperCase())
  .join('');
---

<article class="group relative flex h-full flex-col">
  <!-- Outer soft frame, a step outside the card -->
  <div
    aria-hidden="true"
    class="border-line group-hover:border-line-2 pointer-events-none absolute -inset-1 rounded-[14px] border transition-colors duration-300"
  ></div>

  <div class="border-line bg-surface group-hover:bg-surface-2 relative flex h-full flex-col overflow-hidden rounded-[10px] border transition-colors duration-300">
    <!-- Visual placeholder. Swap for a screenshot later if you like. -->
    <div class="dotgrid border-line relative aspect-[16/9] border-b">
      <div
        aria-hidden="true"
        class="from-surface/80 absolute inset-0 bg-gradient-to-t to-transparent"
      ></div>
      <span
        aria-hidden="true"
        class="text-faint absolute inset-0 flex items-center justify-center font-mono text-3xl font-semibold tracking-widest opacity-60 transition-opacity duration-300 group-hover:opacity-90"
      >
        {initials}
      </span>
      <span class="bg-bg/80 text-muted border-line absolute top-2 left-2 rounded-md border px-1.5 py-0.5 text-[10px] font-semibold tracking-wider uppercase backdrop-blur-sm">
        {projectCategories[category]}
      </span>
      {status && (
        <span class="bg-bg/80 text-ink-2 border-line absolute top-2 right-2 inline-flex items-center gap-1.5 rounded-md border px-1.5 py-0.5 text-[10px] font-semibold backdrop-blur-sm">
          <span aria-hidden="true" class:list={['size-1.5 rounded-full', statusMeta[status].dot]} />
          {statusMeta[status].label}
        </span>
      )}
    </div>

    <div class="flex flex-1 flex-col gap-2.5 p-3.5">
      <h3 class="text-ink text-[15px] leading-tight font-bold tracking-tight">{title}</h3>
      <p class="text-muted text-[13px] leading-relaxed text-pretty">{description}</p>

      {tech.length > 0 ? (
        <TagList items={tech} label={`Technologies used in ${title}`} class="mt-auto pt-1" />
      ) : (
        <p class="text-faint mt-auto pt-1 font-mono text-[11px]" title="Technologies not added yet">
          Tech: TODO
        </p>
      )}

      {(isShown(github) || isShown(demo)) && (
        <div class="border-line mt-1 flex flex-wrap gap-1.5 border-t pt-3">
          {isShown(github) && (
            <Button
              href={github}
              icon="github"
              todoLabel={`GitHub link for ${title} not added yet`}
            >
              GitHub
            </Button>
          )}
          {isShown(demo) && (
            <Button
              href={demo}
              icon="arrow-up-right"
              todoLabel={`Live link for ${title} not added yet`}
            >
              Live
            </Button>
          )}
        </div>
      )}
    </div>
  </div>
</article>
