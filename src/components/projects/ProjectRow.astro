---
import Icon from '@/components/ui/Icon.astro';
import TagList from '@/components/ui/TagList.astro';
import { projectCategories } from '@/config/categories';
import type { Project } from '@/utils/content';
import { href } from '@/utils/url';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, category, summary, tech, github, demo } = project.data;
const caseStudyUrl = href(`/projects/${project.id}/`);

const externalLinks = [
  github && { label: 'GitHub', url: github },
  demo && { label: 'Live demo', url: demo },
].filter((l): l is { label: string; url: string } => Boolean(l));
---

<li class="project-row border-line border-b" data-project data-category={category}>
  <article class="grid gap-x-8 gap-y-5 py-9 sm:py-11 md:grid-cols-12">
    <div class="md:col-span-8">
      <p class="text-muted flex items-center gap-3 font-mono text-xs">
        <span class="project-index text-accent" aria-hidden="true"></span>
        <span>{projectCategories[category]}</span>
      </p>
      <h2 class="font-display text-heading mt-3 tracking-[-0.012em]">
        <a href={caseStudyUrl} class="hover:text-accent transition-colors">
          {title}
        </a>
      </h2>
      <p class="text-muted mt-3 max-w-xl text-pretty">{summary}</p>
      <TagList items={tech} label={`Technologies used in ${title}`} class="mt-5" />
    </div>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-1 md:col-span-4 md:flex-col md:items-end md:justify-start md:gap-1 md:pt-7">
      <a
        href={caseStudyUrl}
        class="group link inline-flex min-h-11 items-center gap-2 text-[0.9375rem] font-medium"
      >
        View case study<span class="sr-only">: {title}</span>
        <Icon
          name="arrow-right"
          size={16}
          class="transition-transform duration-200 group-hover:translate-x-0.5"
        />
      </a>
      {externalLinks.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted hover:text-accent inline-flex min-h-11 items-center gap-1.5 text-[0.9375rem] transition-colors"
        >
          {link.label}
          <span class="sr-only">for {title} (opens in a new tab)</span>
          <Icon name="arrow-up-right" size={15} />
        </a>
      ))}
    </div>
  </article>
</li>
