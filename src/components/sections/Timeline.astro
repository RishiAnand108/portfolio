---
import { render } from 'astro:content';
import DraftBadge from '@/components/ui/DraftBadge.astro';
import TagList from '@/components/ui/TagList.astro';
import Icon from '@/components/ui/Icon.astro';
import type { Experience } from '@/utils/content';

interface Props {
  entries: Experience[];
}

const { entries } = Astro.props;
const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<ol class="border-line relative ml-1.5 border-l">
  {rendered.map(({ entry, Content }) => {
    const { role, organization, date, responsibilities, technologies, links, draft } = entry.data;
    return (
      <li class="relative pb-14 pl-7 last:pb-0 sm:pl-10">
        <span
          aria-hidden="true"
          class:list={[
            'bg-bg absolute top-1.5 -left-[6.5px] size-3 rounded-full border-2',
            draft ? 'border-muted border-dashed' : 'border-accent',
          ]}
        />
        <article class="grid gap-x-8 gap-y-3 lg:grid-cols-[11rem_1fr]">
          <p class="text-muted pt-0.5 font-mono text-xs leading-6">
            {date ?? <span>Dates to be added</span>}
          </p>

          <div>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
              <h2 class="text-xl font-medium tracking-tight">{role}</h2>
              {draft && <DraftBadge label="Draft — details to be confirmed" />}
            </div>
            {organization && <p class="text-muted mt-1">{organization}</p>}

            <div class="text-muted rich-text mt-4 max-w-2xl space-y-3 text-pretty">
              <Content />
            </div>

            {responsibilities.length > 0 && (
              <ul class="mt-4 max-w-2xl space-y-2">
                {responsibilities.map((item) => (
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="bg-line mt-3 h-px w-3 shrink-0" />
                    <span class="text-pretty">{item}</span>
                  </li>
                ))}
              </ul>
            )}

            <TagList items={technologies} label={`Technologies used as ${role}`} class="mt-5" />

            {links.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-x-6">
                {links.map((link) => (
                  <li>
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link inline-flex min-h-11 items-center gap-1.5 text-[0.9375rem]"
                    >
                      {link.label}
                      <span class="sr-only">(opens in a new tab)</span>
                      <Icon name="arrow-up-right" size={15} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </article>
      </li>
    );
  })}
</ol>
