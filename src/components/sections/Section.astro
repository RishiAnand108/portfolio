---
/**
 * Shared shell for every homepage section: an anchor target, a full-bleed
 * dotted rule on top, the small bold heading with a rule beneath it, and the
 * content. Keeping it here means every section looks identical.
 */
import SectionHeading from '@/components/ui/SectionHeading.astro';

interface Props {
  /** Anchor id — must match the `section` value in the nav config. */
  id: string;
  title: string;
  /** Optional one-liner shown under the heading, above the content. */
  intro?: string;
  class?: string;
}

const { id, title, intro, class: className } = Astro.props;
---

<section
  id={id}
  class:list={['relative mt-6 scroll-mt-6', className]}
  aria-labelledby={`${id}-title`}
  data-section
>
  <div aria-hidden="true" class="rule-x rule-bleed top-0"></div>
  <span aria-hidden="true" class="node top-0 -left-4 -translate-x-1/2 -translate-y-1/2"></span>
  <span aria-hidden="true" class="node top-0 -right-4 translate-x-1/2 -translate-y-1/2"></span>

  <SectionHeading id={`${id}-title`} title={title}>
    <slot name="action" slot="action" />
  </SectionHeading>

  {intro && <p class="text-muted mt-4 text-[13.5px] leading-relaxed text-pretty">{intro}</p>}

  <div class="pt-5 pb-6">
    <slot />
  </div>
</section>
