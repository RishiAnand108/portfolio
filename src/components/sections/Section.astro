---
/**
 * Shared shell for every homepage section: an anchor target, a full-bleed
 * dotted rule on top, the small bold heading with a rule beneath it, and the
 * content. Keeping it here means every section looks identical.
 */
import EdgeRule from '@/components/ui/EdgeRule.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';

interface Props {
  /** Anchor id — must match the `section` value in the nav config. */
  id: string;
  title: string;
  class?: string;
}

const { id, title, class: className } = Astro.props;
---

<section
  id={id}
  class:list={['relative mt-6 scroll-mt-6', className]}
  aria-labelledby={`${id}-title`}
  data-section
>
  <EdgeRule variant="top" />

  <SectionHeading id={`${id}-title`} title={title}>
    <slot name="action" slot="action" />
  </SectionHeading>

  <div class="pt-5 pb-6">
    <slot />
  </div>
</section>
