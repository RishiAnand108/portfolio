---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { aboutPreview } from '@/config/site';
import { href } from '@/utils/url';
---

<section class="border-line border-t" aria-labelledby="about-preview-title">
  <div class="container-page section grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <SectionHeading
        id="about-preview-title"
        index="02"
        eyebrow="About"
        title="Engineer first, curious always."
      />
    </div>

    <div class="lg:col-span-8">
      <p class="text-lead max-w-2xl text-pretty">{aboutPreview}</p>
      <a
        href={href('/about/')}
        class="group link mt-8 inline-flex min-h-11 items-center gap-2 font-medium"
      >
        More about me
        <Icon
          name="arrow-right"
          size={16}
          class="transition-transform duration-200 group-hover:translate-x-0.5"
        />
      </a>
    </div>
  </div>
</section>
