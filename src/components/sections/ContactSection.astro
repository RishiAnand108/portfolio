---
import Section from './Section.astro';
import Button from '@/components/ui/Button.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import { links } from '@/config/site';
import { href, isExternal } from '@/utils/url';
import { isShown, isTodo } from '@/utils/links';

const handle = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const channels = (
  [
    {
      label: 'Email',
      value: links.email,
      url: links.email ? `mailto:${links.email}` : '',
      icon: 'mail' as IconName,
      note: 'Best for roles, project enquiries and collaboration.',
    },
    {
      label: 'GitHub',
      value: isTodo(links.github) ? 'TODO' : handle(links.github),
      url: links.github,
      icon: 'github' as IconName,
      note: 'Code, experiments and open-source work.',
    },
    {
      label: 'LinkedIn',
      value: isTodo(links.linkedin) ? 'TODO' : handle(links.linkedin),
      url: links.linkedin,
      icon: 'linkedin' as IconName,
      note: 'Professional background and updates.',
    },
    {
      label: 'Resume',
      value: isTodo(links.resume) ? 'TODO' : 'Download PDF',
      url: links.resume,
      icon: 'file-text' as IconName,
      note: 'A one-page summary of my work.',
    },
  ] as const
).filter((c) => isShown(c.url));
---

<Section id="contact" title="Contact">
  <p class="text-ink-2 text-[14px] leading-relaxed text-pretty sm:text-[15px]">
    I’m happy to talk about backend roles, internships, AI/ML work or a problem you think is
    interesting. Email is the most reliable way to reach me.
  </p>

  {links.email && (
    <div class="mt-4">
      <Button href={`mailto:${links.email}`} variant="primary" size="md" icon="mail">
        Send an email
      </Button>
    </div>
  )}

  <ul class="border-line-2 bg-surface divide-line-2 mt-6 divide-y rounded-lg border">
    {channels.map((channel) => {
      const todo = isTodo(channel.url);
      const external = !todo && isExternal(channel.url);
      const inner = (
        <>
          <span class="text-muted flex w-24 shrink-0 items-center gap-2 text-[12px] font-medium">
            <Icon name={channel.icon} size={14} class="text-faint" />
            {channel.label}
          </span>
          <span class="min-w-0 flex-1">
            <span
              class:list={[
                'block truncate text-[14px] font-medium',
                todo
                  ? 'text-faint font-mono text-[12px]'
                  : 'text-ink group-hover:text-accent transition-colors',
              ]}
            >
              {todo ? 'TODO — link not added yet' : channel.value}
            </span>
            <span class="text-muted mt-0.5 block text-[12px]">{channel.note}</span>
          </span>
          {!todo && (
            <Icon
              name="arrow-up-right"
              size={16}
              class="text-faint group-hover:text-accent shrink-0 transition-colors"
            />
          )}
        </>
      );
      return (
        <li>
          {todo ? (
            <div class="flex items-center gap-4 px-4 py-3" aria-disabled="true" data-todo>
              {inner}
              <span class="sr-only">({channel.label} link not added yet)</span>
            </div>
          ) : (
            <a
              href={href(channel.url)}
              class="group hover:bg-surface-2 flex items-center gap-4 px-4 py-3 transition-colors"
              {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {inner}
              {external && <span class="sr-only">(opens in a new tab)</span>}
            </a>
          )}
        </li>
      );
    })}
  </ul>
</Section>
