---
import Section from './Section.astro';
import Button from '@/components/ui/Button.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import { links } from '@/config/site';
import { href, isExternal } from '@/utils/url';

const handle = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

// Channels without a configured URL are never rendered, so nothing dead ships.
const channels = (
  [
    {
      label: 'Email',
      value: links.email,
      url: links.email ? `mailto:${links.email}` : '',
      icon: 'mail' as IconName,
      note: 'Best for roles, project enquiries and collaboration.',
    },
    {
      label: 'GitHub',
      value: handle(links.github),
      url: links.github,
      icon: 'github' as IconName,
      note: 'Code, experiments and open-source work.',
    },
    {
      label: 'LinkedIn',
      value: handle(links.linkedin),
      url: links.linkedin,
      icon: 'linkedin' as IconName,
      note: 'Professional background and updates.',
    },
    {
      label: 'Resume',
      value: 'Download PDF',
      url: links.resume,
      icon: 'file-text' as IconName,
      note: 'A one-page summary of my work.',
    },
  ] as const
).filter((channel) => channel.url);
---

<Section id="contact" index="06" eyebrow="Contact" title="Let’s build something useful.">
  <p class="text-lead max-w-2xl text-pretty">
    I’m happy to talk about backend roles, internships, AI/ML work or a problem you think is
    interesting. Email is the most reliable way to reach me — I read everything that isn’t a
    template.
  </p>

  {links.email && (
    <div class="mt-8">
      <Button href={`mailto:${links.email}`} icon="arrow-up-right">
        Email me
      </Button>
    </div>
  )}

  <ul class="border-line mt-10 border-t">
    {channels.map((channel) => {
      const external = isExternal(channel.url);
      return (
        <li class="border-line border-b">
          <a
            href={href(channel.url)}
            class="group grid items-center gap-x-6 gap-y-1 py-5 sm:grid-cols-[7rem_1fr_auto] sm:py-6"
            {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <span class="text-muted flex items-center gap-2.5 font-mono text-xs">
              <Icon name={channel.icon} size={16} />
              {channel.label}
            </span>
            <span class="min-w-0">
              <span class="group-hover:text-accent block text-lg break-words transition-colors">
                {channel.value}
              </span>
              <span class="text-muted mt-0.5 block text-[0.9375rem]">{channel.note}</span>
            </span>
            <span class="text-muted group-hover:text-accent hidden transition-colors sm:block">
              <Icon name="arrow-up-right" size={20} />
            </span>
            {external && <span class="sr-only">(opens in a new tab)</span>}
          </a>
        </li>
      );
    })}
  </ul>
</Section>
