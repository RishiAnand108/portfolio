---
import Button from '@/components/ui/Button.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import ProfileCard from './ProfileCard.astro';
import { hero, site } from '@/config/site';
---

<section
  id="home"
  class="container-page pt-14 pb-16 sm:pt-20 lg:pt-28 lg:pb-24"
  aria-labelledby="hero-title"
  data-section
>
  <div class="grid items-end gap-12 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-8">
      {site.availability.show && (
        <p class="reveal text-muted mb-8 inline-flex items-center gap-2.5 font-mono text-xs sm:text-[0.8125rem]">
          <span aria-hidden="true" class="bg-accent size-2 rounded-full" />
          {site.availability.label}
        </p>
      )}

      <h1 id="hero-title" class="reveal" style="--i:1">
        <span class="text-muted block text-base sm:text-lg">
          <span class="text-ink font-medium">{site.fullName}</span>
          <span aria-hidden="true" class="mx-1.5">
            —
          </span>
          <span class="sr-only">, </span>
          {site.role}
        </span>
        <span class="font-display text-display mt-5 block tracking-[-0.012em] text-balance">
          {hero.headline}
        </span>
      </h1>

      <p class="reveal text-muted text-lead mt-7 max-w-xl text-pretty" style="--i:2">
        {hero.supporting}
      </p>

      <div class="reveal mt-10 flex flex-col gap-3 min-[420px]:flex-row" style="--i:3">
        <Button href="/#projects" icon="arrow-right">
          View Projects
        </Button>
        <Button href="/#contact" variant="secondary">
          Contact Me
        </Button>
      </div>

      <SocialLinks include={['github', 'linkedin', 'resume']} class="reveal mt-7" />
    </div>

    <div class="reveal lg:col-span-4" style="--i:4">
      <ProfileCard />
    </div>
  </div>
</section>
