---
/**
 * Hero: banner strip, profile row (avatar, name, role, theme toggle), a
 * one-line tagline, short bullets, the primary actions, social pills and
 * the availability line.
 */
import HeroBanner from './HeroBanner.astro';
import Button from '@/components/ui/Button.astro';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import type { IconName } from '@/components/ui/Icon.astro';
import { hero, links, site } from '@/config/site';
import { href } from '@/utils/url';
import { isShown } from '@/utils/links';

const initial = site.name.charAt(0);

interface Social {
  label: string;
  url: string;
  icon: IconName;
}

const allSocials: Social[] = [
  { label: 'GitHub', url: links.github, icon: 'github' },
  { label: 'LinkedIn', url: links.linkedin, icon: 'linkedin' },
  { label: 'Twitter', url: links.x, icon: 'x' },
  { label: 'Email', url: links.email ? `mailto:${links.email}` : '', icon: 'mail' },
];
const socials = allSocials.filter((s) => isShown(s.url));
---

<section id="home" class="relative" aria-labelledby="hero-title" data-hero>
  <header>
    <!-- Cinematic banner, full column width, with the live clock -->
    <div class="relative">
      <HeroBanner />
      <div aria-hidden="true" class="rule-x rule-bleed bottom-0"></div>
      <span
        aria-hidden="true"
        class="node bottom-0 -left-4 -translate-x-1/2 translate-y-1/2"
      ></span>
      <span
        aria-hidden="true"
        class="node -right-4 bottom-0 translate-x-1/2 translate-y-1/2"
      ></span>
    </div>

    <!-- Profile row -->
    <div class="relative flex items-center justify-between gap-4 py-4">
      <div class="flex items-center gap-4">
        <div class="border-line-2 shrink-0 rounded-lg border p-[3px]">
          {site.avatar ? (
            <img
              src={href(site.avatar)}
              alt="Rishikesh cartoon profile portrait"
              width="80"
              height="80"
              class="bg-surface-2 size-16 rounded-[5px] object-cover object-center sm:size-20"
            />
          ) : (
            <div
              role="img"
              aria-label={`Placeholder avatar for ${site.fullName}`}
              class="bg-surface-2 text-muted flex size-16 items-center justify-center rounded-[5px] font-mono text-2xl font-semibold sm:size-20"
            >
              {initial}
            </div>
          )}
        </div>
        <div class="reveal">
          <h1
            id="hero-title"
            class="text-ink text-[20px] leading-none font-bold tracking-tight sm:text-[24px]"
          >
            {site.name}
            <span class="text-muted font-medium">({site.shortName})</span>
          </h1>
          <p class="text-muted mt-1.5 text-[13px] sm:text-[14px]">{site.role}</p>
        </div>
      </div>

      <div class="flex items-center self-start">
        <ThemeToggle />
      </div>

      <div aria-hidden="true" class="rule-x rule-bleed bottom-0"></div>
      <span
        aria-hidden="true"
        class="node bottom-0 -left-4 -translate-x-1/2 translate-y-1/2"
      ></span>
      <span
        aria-hidden="true"
        class="node -right-4 bottom-0 translate-x-1/2 translate-y-1/2"
      ></span>
    </div>
  </header>

  <!-- Intro -->
  <p class="text-ink-2 reveal mt-4 text-[14px] leading-relaxed sm:text-[15px]" style="--i:1">
    {hero.tagline}
  </p>

  <ul
    class="text-ink-2 reveal mt-4 space-y-1.5 pl-1 text-[14px] leading-relaxed sm:text-[15px]"
    style="--i:2"
  >
    {hero.bullets.map((bullet) => (
      <li class="flex gap-2.5">
        <span aria-hidden="true" class="text-faint">
          •
        </span>
        <span class="text-pretty">{bullet}</span>
      </li>
    ))}
  </ul>

  <div class="reveal mt-5 flex flex-wrap items-center gap-2" style="--i:3">
    {links.email && (
      <Button href={`mailto:${links.email}`} variant="primary" icon="mail">
        Send an email
      </Button>
    )}
    <Button href={links.resume} icon="file-text" todoLabel="Resume link not added yet">
      Resume
    </Button>
  </div>

  {socials.length > 0 && (
    <div class="reveal mt-6" style="--i:4">
      <h2 class="text-muted mb-2 text-[13px]">
        Here are my <span class="text-ink font-medium">socials</span>
      </h2>
      <ul class="flex flex-wrap gap-1.5">
        {socials.map((s) => (
          <li>
            <Button href={s.url} icon={s.icon} todoLabel={`${s.label} link not added yet`}>
              {s.label}
            </Button>
          </li>
        ))}
      </ul>
    </div>
  )}

  {site.availability.show && (
    <p class="text-muted reveal mt-5 flex items-center gap-2 text-[12px]" style="--i:5">
      <span class="relative flex size-2">
        <span class="bg-live absolute inline-flex size-full animate-ping rounded-full opacity-60" />
        <span class="bg-live relative inline-flex size-2 rounded-full" />
      </span>
      {site.availability.label}
    </p>
  )}
</section>
