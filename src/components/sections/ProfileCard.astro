---
/**
 * A small nod to backend work: the profile rendered as an API response.
 * Purely presentational — the same facts are stated in the hero copy,
 * so the block is exposed to assistive tech as a single labelled figure.
 */
import { profile, site } from '@/config/site';

const escape = (s: string) =>
  s
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;');

const str = (s: string) => `<span class="text-ink">"${escape(s)}"</span>`;

const lines = Object.entries(profile).map(([key, value], i, all) => {
  // Arrays are printed one item per line so the card never wraps awkwardly.
  const rendered = Array.isArray(value)
    ? ['[', value.map((v) => `    ${str(v)}`).join(',\n'), '  ]'].join('\n')
    : str(value);
  const comma = i < all.length - 1 ? ',' : '';
  return `  <span class="text-muted">"${escape(key)}":</span> ${rendered}${comma}`;
});

const json = ['{', ...lines, '}'].join('\n');
const path = `/${site.name.toLowerCase()}`;
---

<figure
  class="border-line bg-surface/60 overflow-hidden rounded-xl border font-mono text-[0.8125rem] leading-relaxed"
  role="img"
  aria-label={`Profile summary shown as an API response: ${site.role}.`}
>
  <div class="border-line text-muted flex items-center justify-between gap-3 border-b px-4 py-2.5">
    <span>
      <span class="text-accent">GET</span> {path}
    </span>
    <span class="flex items-center gap-1.5">
      <span class="bg-accent size-1.5 rounded-full"></span>200 OK
    </span>
  </div>
  <pre
    class="text-muted px-4 py-4 break-words whitespace-pre-wrap"
    aria-hidden="true"
  ><code set:html={json} /></pre>
</figure>
