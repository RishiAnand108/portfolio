---
/**
 * Experience as a compact expandable list — collapsed rows by default,
 * matching a summary-row layout rather than oversized cards. The rows and
 * their accordion behaviour live in ExperienceList; the entries themselves
 * in src/data/experience.ts.
 */
import Section from './Section.astro';
import ExperienceList from '@/components/experience/ExperienceList.astro';
import { experience } from '@/data/experience';
---

<Section id="experience" title="Experiences">
  {experience.length === 0 ? (
    <p class="text-muted text-[14px]">Experience entries will be added soon.</p>
  ) : (
    <ExperienceList />
  )}
</Section>
