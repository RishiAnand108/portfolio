---
import Section from './Section.astro';
import Timeline from './Timeline.astro';
import { getExperience } from '@/utils/content';

const entries = await getExperience();
---

<Section
  id="experience"
  index="02"
  eyebrow="Experience"
  title="Where I’ve worked and what I worked on."
>
  {entries.length > 0 ? (
    <Timeline entries={entries} />
  ) : (
    <p class="text-muted">Experience entries will be added soon.</p>
  )}
</Section>
