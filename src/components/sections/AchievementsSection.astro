---
import Section from './Section.astro';
import Icon from '@/components/ui/Icon.astro';
import { achievements } from '@/config/achievements';
---

<Section
  id="achievements"
  index="05"
  eyebrow="Achievements & community"
  title="Programs, leadership and community work."
>
  <ul class="divide-line border-line divide-y border-y">
    {achievements.map((item) => (
      <li class="py-6">
        <article>
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h3 class="text-lg font-medium tracking-tight">{item.title}</h3>
            {item.period && <span class="text-muted font-mono text-xs">{item.period}</span>}
          </div>
          {item.organization && <p class="text-muted mt-1 text-[0.9375rem]">{item.organization}</p>}
          <p class="text-muted mt-3 max-w-2xl text-pretty">{item.detail}</p>
          {item.url && (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted hover:text-accent mt-2 inline-flex min-h-11 items-center gap-1.5 text-[0.9375rem] transition-colors"
            >
              Details
              <span class="sr-only">about {item.title} (opens in a new tab)</span>
              <Icon name="arrow-up-right" size={15} />
            </a>
          )}
        </article>
      </li>
    ))}
  </ul>
</Section>
