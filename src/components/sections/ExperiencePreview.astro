---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import DraftBadge from '@/components/ui/DraftBadge.astro';
import Icon from '@/components/ui/Icon.astro';
import { getExperience } from '@/utils/content';
import { href } from '@/utils/url';

const entries = (await getExperience()).slice(0, 3);
---

{entries.length > 0 && (
  <section class="border-line border-t" aria-labelledby="experience-preview-title">
    <div class="container-page section grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading
          id="experience-preview-title"
          index="03"
          eyebrow="Experience"
          title="Recent roles and involvement."
        />
      </div>

      <div class="lg:col-span-8">
        <ul class="divide-line border-line divide-y border-y">
          {entries.map((entry) => (
            <li class="flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="font-medium">{entry.data.role}</span>
                {entry.data.organization && (
                  <span class="text-muted">{entry.data.organization}</span>
                )}
                {entry.data.draft && <DraftBadge />}
              </div>
              {entry.data.date && (
                <span class="text-muted shrink-0 font-mono text-xs">{entry.data.date}</span>
              )}
            </li>
          ))}
        </ul>
        <a
          href={href('/experience/')}
          class="group link mt-8 inline-flex min-h-11 items-center gap-2 font-medium"
        >
          Full experience
          <Icon
            name="arrow-right"
            size={16}
            class="transition-transform duration-200 group-hover:translate-x-0.5"
          />
        </a>
      </div>
    </div>
  </section>
)}
