---
import EdgeRule from '@/components/ui/EdgeRule.astro';
import { site } from '@/config/site';

const year = new Date().getFullYear();
---

<footer class="relative mt-10">
  <div class="col relative">
    <EdgeRule variant="top-flush" />

    <!-- Fading dot grid, the same texture as the banner, so the page closes
         the way it opened. -->
    <div
      aria-hidden="true"
      class="dotgrid pointer-events-none absolute inset-x-0 top-0 h-52"
      style="mask-image: linear-gradient(to bottom, black, transparent); -webkit-mask-image: linear-gradient(to bottom, black, transparent)"
    ></div>

    <div class="relative flex flex-col items-center gap-2 pt-28 pb-10 text-center">
      <p class="text-muted text-[12px]">
        © {year} {site.fullName}. Built with Astro, hosted on GitHub Pages.
      </p>
      <p class="text-faint font-mono text-[10px] tracking-[0.2em] uppercase">
        {site.role.replace('|', '·')}
      </p>
    </div>
  </div>
</footer>
