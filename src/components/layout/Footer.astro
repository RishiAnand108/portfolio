---
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';

const year = new Date().getFullYear();
---

<footer class="border-line border-t">
  <div class="container-page py-8 sm:py-10">
    <p class="text-muted flex items-center justify-center gap-1.5 text-center font-mono text-xs">
      © {year} {site.fullName}. Built with love.
      <Icon name="heart" size={13} class="text-accent" />
    </p>
  </div>
</footer>
