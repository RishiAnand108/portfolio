---
/**
 * One experience entry: a collapsed header row (logo or initials, title,
 * role, dates, location) that expands to the description, metrics, bullets,
 * technology tags and the company link.
 *
 * The header is a <button> inside the row's heading (the accordion pattern),
 * so Enter / Space toggle it and `aria-expanded` / `aria-controls` expose the
 * state. Open state is the `data-open` attribute on the root, set by the
 * script in ExperienceList; every animation below hangs off it. The panel is
 * `invisible` while closed so its content is out of the tab order and the
 * accessibility tree — visibility stays "visible" for the whole transition,
 * so it does not cut the closing animation short.
 */
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import TagList from '@/components/ui/TagList.astro';
import type { ExperienceEntry } from '@/data/experience';
import { href } from '@/utils/url';
import { isTodo, isShown } from '@/utils/links';
import { initials } from '@/utils/text';

interface Props {
  entry: ExperienceEntry;
}

const { entry } = Astro.props;

const dateRange = (start: string, end: string) => {
  if (isTodo(start) && isTodo(end)) return null;
  if (start === end) return start;
  const s = isTodo(start) ? 'TODO' : start;
  const e = isTodo(end) ? 'TODO' : end;
  return `${s} – ${e}`;
};

const range = dateRange(entry.start, entry.end);
const headerId = `experience-${entry.id}-header`;
const panelId = `experience-${entry.id}-panel`;
---

<div class="group" data-experience-item>
  <h3>
    <button
      type="button"
      id={headerId}
      class="flex w-full cursor-pointer items-start gap-3 py-3.5 text-left"
      aria-expanded="false"
      aria-controls={panelId}
      data-experience-trigger
    >
      <span
        aria-hidden="true"
        class:list={[
          'border-line-2 text-muted mt-0.5 flex size-9 shrink-0 items-center justify-center overflow-hidden rounded-lg border font-mono text-[11px] font-semibold sm:size-10',
          // Logos ship on a white ground; keep the tile white in both themes.
          entry.logo ? 'bg-white' : 'bg-surface',
        ]}
      >
        {entry.logo ? (
          <img
            src={href(entry.logo)}
            alt=""
            width="40"
            height="40"
            loading="lazy"
            class="size-full object-contain p-0.5"
          />
        ) : (
          initials(entry.title)
        )}
      </span>

      <span class="flex min-w-0 flex-1 flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
        <span class="block min-w-0">
          <span class="flex items-center gap-2">
            <span class="text-ink text-[14px] leading-snug font-semibold tracking-tight sm:text-[15px]">
              {entry.title}
            </span>
            {entry.secondaryLogo && (
              <img
                src={href(entry.secondaryLogo)}
                alt={entry.secondaryLogoAlt ?? ''}
                width="16"
                height="16"
                loading="lazy"
                class="size-4 shrink-0 rounded-[3px] object-contain"
              />
            )}
          </span>
          <span class="text-muted mt-0.5 block text-[13px] leading-snug font-normal">
            {entry.role}
            {entry.employmentType && <span class="text-muted/80"> · {entry.employmentType}</span>}
          </span>
        </span>

        <span class="block font-normal sm:min-w-[9.5rem] sm:text-right">
          <span class="text-muted block text-[13px] leading-snug whitespace-nowrap">
            {range ?? (
              <span class="text-faint" title="Dates not added yet">
                TODO
              </span>
            )}
          </span>
          <span class="text-muted/80 mt-0.5 block text-[13px] leading-snug">
            {isTodo(entry.location) ? (
              <span class="text-faint" title="Location not added yet">
                TODO
              </span>
            ) : (
              entry.location
            )}
          </span>
        </span>
      </span>

      <span
        aria-hidden="true"
        class="text-faint group-hover:text-muted mt-1 shrink-0 transition-transform duration-300 group-data-[open]:rotate-180"
        data-experience-chevron
      >
        <Icon name="chevron-down" size={14} />
      </span>
    </button>
  </h3>

  <div
    id={panelId}
    role="region"
    aria-labelledby={headerId}
    class="invisible grid grid-rows-[0fr] transition-[grid-template-rows,visibility] duration-300 ease-out group-data-[open]:visible group-data-[open]:grid-rows-[1fr]"
    data-experience-panel
  >
    <div class="min-h-0 overflow-hidden">
      <!-- Full-width body: it lines up with the row's outer edges (the logo's
           left edge), not with the title column, so text gets the whole width. -->
      <div
        class="-translate-y-1 pb-4 opacity-0 transition-[opacity,translate] duration-300 ease-out group-data-[open]:translate-y-0 group-data-[open]:opacity-100 sm:pb-5"
        data-experience-content
      >
        <div aria-hidden="true" class="rule-x"></div>
        <div class="flex flex-col gap-3 pt-3 sm:gap-3.5 sm:pt-3.5">
          {entry.metrics && entry.metrics.length > 0 && (
            <dl class="border-line-2 bg-surface divide-line-2 grid grid-cols-2 divide-x rounded-lg border sm:grid-cols-4">
              {entry.metrics.map((m) => (
                <div class="px-3 py-2">
                  <dt class="text-faint text-[10px] font-semibold tracking-wider uppercase">
                    {m.label}
                  </dt>
                  <dd class="text-ink mt-0.5 text-[14px] font-semibold">{m.value}</dd>
                </div>
              ))}
            </dl>
          )}

          {entry.description && (
            <p class="text-ink-2 text-[13.5px] leading-relaxed text-pretty">{entry.description}</p>
          )}

          {entry.bullets.length > 0 && (
            <ul class="text-ink-2 space-y-1.5 text-[13.5px] leading-relaxed">
              {entry.bullets.map((item) => (
                <li class="flex gap-2.5">
                  <span aria-hidden="true" class="text-faint">
                    •
                  </span>
                  <span class="text-pretty">{item}</span>
                </li>
              ))}
            </ul>
          )}

          <TagList items={entry.technologies} label={`Technologies used at ${entry.title}`} />

          {isShown(entry.link) && (
            <div>
              <Button
                href={entry.link}
                icon="arrow-up-right"
                todoLabel="Company link not added yet"
              >
                Website
              </Button>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</div>
