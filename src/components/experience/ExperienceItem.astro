---
/**
 * One experience entry: a collapsed summary row (logo or initials,
 * organisation, role, dates, location) that expands to the description,
 * metrics, responsibilities, tech tags and the company link.
 *
 * It is a native <details>/<summary>, so it works without JavaScript, is
 * keyboard accessible (Enter / Space on the header) and exposes its expanded
 * state to assistive technology. The open/close animation is added by the
 * script in ExperienceSection, which finds rows by `data-experience`.
 */
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import TagList from '@/components/ui/TagList.astro';
import type { ExperienceEntry } from '@/config/experience';
import { href } from '@/utils/url';
import { isTodo, isShown } from '@/utils/links';
import { initials } from '@/utils/text';

interface Props {
  entry: ExperienceEntry;
}

const { entry } = Astro.props;

const dateRange = (start: string, end: string) => {
  if (isTodo(start) && isTodo(end)) return null;
  const s = isTodo(start) ? 'TODO' : start;
  const e = isTodo(end) ? 'TODO' : end;
  return `${s} – ${e}`;
};

const range = dateRange(entry.start, entry.end);
const panelId = `experience-${entry.id}`;
---

<details class="group" data-experience>
  <summary
    class="flex cursor-pointer list-none items-start gap-3 py-3.5 select-none [&::-webkit-details-marker]:hidden"
    aria-controls={panelId}
  >
    <span
      aria-hidden="true"
      class="border-line-2 bg-surface text-muted mt-0.5 flex size-9 shrink-0 items-center justify-center overflow-hidden rounded-lg border font-mono text-[11px] font-semibold sm:size-10"
    >
      {entry.logo ? (
        <img
          src={href(entry.logo)}
          alt=""
          width="40"
          height="40"
          loading="lazy"
          class="size-full object-contain p-1"
        />
      ) : (
        initials(entry.organization)
      )}
    </span>

    <div class="flex min-w-0 flex-1 flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
      <div class="min-w-0">
        <h3 class="text-ink text-[14px] leading-snug font-semibold tracking-tight sm:text-[15px]">
          {entry.organization}
        </h3>
        <p class="text-muted mt-0.5 text-[13px] leading-snug">{entry.role}</p>
      </div>

      <div class="sm:min-w-[9.5rem] sm:text-right">
        <p class="text-muted text-[13px] leading-snug whitespace-nowrap">
          {range ?? (
            <span class="text-faint" title="Dates not added yet">
              TODO
            </span>
          )}
        </p>
        <p class="text-muted/80 mt-0.5 text-[13px] leading-snug">
          {isTodo(entry.location) ? (
            <span class="text-faint" title="Location not added yet">
              TODO
            </span>
          ) : (
            entry.location
          )}
        </p>
      </div>
    </div>

    <span
      aria-hidden="true"
      class="text-faint group-hover:text-muted mt-1 shrink-0 transition-transform duration-300 group-open:rotate-180"
    >
      <Icon name="chevron-down" size={14} />
    </span>
  </summary>

  <div
    id={panelId}
    class="grid grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-out data-[closed]:grid-rows-[0fr]"
    data-panel
  >
    <div class="min-h-0 overflow-hidden">
      <div class="pt-0.5 pb-4 pl-12 sm:pl-[3.25rem]">
        {entry.description && (
          <p class="text-ink-2 text-[13.5px] leading-relaxed text-pretty">{entry.description}</p>
        )}

        {entry.metrics && entry.metrics.length > 0 && (
          <dl class="border-line-2 bg-surface divide-line-2 mt-3 grid grid-cols-2 divide-x rounded-lg border sm:grid-cols-4">
            {entry.metrics.map((m) => (
              <div class="px-3 py-2">
                <dt class="text-faint text-[10px] font-semibold tracking-wider uppercase">
                  {m.label}
                </dt>
                <dd class="text-ink mt-0.5 text-[14px] font-semibold">{m.value}</dd>
              </div>
            ))}
          </dl>
        )}

        {entry.responsibilities.length > 0 && (
          <ul class="text-ink-2 mt-3 space-y-1.5 text-[13.5px] leading-relaxed">
            {entry.responsibilities.map((item) => (
              <li class="flex gap-2.5">
                <span aria-hidden="true" class="text-faint">
                  •
                </span>
                <span class="text-pretty">{item}</span>
              </li>
            ))}
          </ul>
        )}

        <TagList
          items={entry.tech}
          label={`Technologies used at ${entry.organization}`}
          class="mt-3"
        />

        {isShown(entry.link) && (
          <div class="mt-3">
            <Button href={entry.link} icon="arrow-up-right" todoLabel="Company link not added yet">
              Website
            </Button>
          </div>
        )}
      </div>
    </div>
  </div>
</details>
