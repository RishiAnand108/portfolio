---
import Icon, { type IconName } from './Icon.astro';
import { links } from '@/config/site';
import { href as withBase, isExternal } from '@/utils/url';

type LinkKey = 'email' | 'github' | 'linkedin' | 'resume';

interface Props {
  /** "icons" renders icon-only buttons, "text" renders labelled links. */
  variant?: 'icons' | 'text';
  include?: LinkKey[];
  class?: string;
}

const {
  variant = 'text',
  include = ['email', 'github', 'linkedin', 'resume'],
  class: className,
} = Astro.props;

const all: { key: LinkKey; label: string; url: string; icon: IconName }[] = [
  { key: 'email', label: 'Email', url: links.email ? `mailto:${links.email}` : '', icon: 'mail' },
  { key: 'github', label: 'GitHub', url: links.github, icon: 'github' },
  { key: 'linkedin', label: 'LinkedIn', url: links.linkedin, icon: 'linkedin' },
  { key: 'resume', label: 'Resume', url: links.resume, icon: 'file-text' },
];

// Links without a configured URL are never rendered.
const items = all.filter((l) => l.url && include.includes(l.key));
---

<ul
  class:list={[
    'flex flex-wrap items-center',
    variant === 'icons' ? 'gap-1' : 'gap-x-6 gap-y-1',
    className,
  ]}
>
  {items.map((item) => {
    const external = isExternal(item.url);
    const attrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
    return (
      <li>
        {variant === 'icons' ? (
          <a
            href={withBase(item.url)}
            aria-label={external ? `${item.label} (opens in a new tab)` : item.label}
            class="text-muted hover:text-accent inline-flex size-11 items-center justify-center rounded-full transition-colors"
            {...attrs}
          >
            <Icon name={item.icon} size={20} />
          </a>
        ) : (
          <a
            href={withBase(item.url)}
            class="group text-ink hover:text-accent inline-flex min-h-11 items-center gap-2 text-[0.9375rem] font-medium transition-colors"
            {...attrs}
          >
            <Icon name={item.icon} size={17} class="text-muted group-hover:text-accent" />
            <span class="decoration-line underline decoration-1 underline-offset-4 group-hover:decoration-current">
              {item.label}
            </span>
            {external && <span class="sr-only">(opens in a new tab)</span>}
          </a>
        )}
      </li>
    );
  })}
</ul>
