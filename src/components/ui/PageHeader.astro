---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<header class="container-page pt-14 pb-10 sm:pt-20 sm:pb-14 lg:pt-28">
  <Eyebrow class="reveal">{eyebrow}</Eyebrow>
  <h1
    class="font-display text-title reveal mt-6 max-w-4xl tracking-[-0.012em] text-balance"
    style="--i:1"
  >
    {title}
  </h1>
  {intro && (
    <p class="text-muted text-lead reveal mt-6 max-w-2xl text-pretty" style="--i:2">
      {intro}
    </p>
  )}
  <slot />
</header>
