---
interface Props {
  index?: string;
  class?: string;
}
const { index, class: className } = Astro.props;
---

<p
  class:list={[
    'text-muted flex items-center gap-3 font-mono text-xs sm:text-[0.8125rem]',
    className,
  ]}
>
  {index && <span class="text-accent">{index}</span>}
  <span aria-hidden="true" class="bg-line h-px w-8"></span>
  <span>
    <slot />
  </span>
</p>
