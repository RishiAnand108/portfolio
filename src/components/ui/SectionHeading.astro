---
/**
 * Small bold section title with a full-bleed dotted rule beneath it and
 * nodes where the rule meets the column edges.
 */
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<div class="relative flex items-center justify-between gap-4 py-2">
  <h2 id={id} class="text-ink text-[18px] font-bold tracking-tight">
    {title}
  </h2>
  <slot name="action" />
  <div aria-hidden="true" class="rule-x rule-bleed bottom-0"></div>
  <span aria-hidden="true" class="node bottom-0 -left-4 -translate-x-1/2 translate-y-1/2"></span>
  <span aria-hidden="true" class="node -right-4 bottom-0 translate-x-1/2 translate-y-1/2"></span>
</div>
