---
/**
 * Small bold section title with a full-bleed dotted rule beneath it and
 * nodes where the rule meets the column edges.
 */
import EdgeRule from './EdgeRule.astro';

interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<div class="relative flex items-center justify-between gap-4 py-2">
  <h2 id={id} class="text-ink text-[18px] font-bold tracking-tight">
    {title}
  </h2>
  <slot name="action" />
  <EdgeRule variant="bottom" />
</div>
