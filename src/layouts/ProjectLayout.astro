---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import TagList from '@/components/ui/TagList.astro';
import ProjectPager from '@/components/projects/ProjectPager.astro';
import { projectCategories } from '@/config/categories';
import type { Project } from '@/utils/content';
import { href } from '@/utils/url';

interface Props {
  project: Project;
  headings: MarkdownHeading[];
  previous?: Project;
  next?: Project;
}

const { project, headings, previous, next } = Astro.props;
const { title, category, summary, tech, github, demo, cover, coverAlt, draft } = project.data;
const sections = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={title} description={summary} type="article">
  <article>
    <header class="container-page pt-10 pb-12 sm:pt-14 sm:pb-16 lg:pt-20">
      <a
        href={href('/#projects')}
        class="group text-muted hover:text-ink reveal inline-flex min-h-11 items-center gap-2 text-sm transition-colors"
      >
        <Icon
          name="arrow-left"
          size={15}
          class="transition-transform duration-200 group-hover:-translate-x-0.5"
        />
        All projects
      </a>

      <Eyebrow class="reveal mt-8">{projectCategories[category]}</Eyebrow>
      <h1
        class="font-display text-title reveal mt-6 max-w-4xl tracking-[-0.012em] text-balance"
        style="--i:1"
      >
        {title}
      </h1>
      <p class="text-muted text-lead reveal mt-6 max-w-2xl text-pretty" style="--i:2">
        {summary}
      </p>

      <dl
        class="border-line reveal mt-10 grid gap-x-10 gap-y-6 border-t pt-8 sm:grid-cols-[1fr_auto]"
        style="--i:3"
      >
        <div>
          <dt class="text-muted font-mono text-xs">Stack</dt>
          <dd class="mt-3">
            <TagList items={tech} label="Technology stack" />
          </dd>
        </div>
        {(github || demo) && (
          <div>
            <dt class="text-muted font-mono text-xs">Links</dt>
            <dd class="mt-3 flex flex-wrap gap-3">
              {demo && (
                <Button href={demo} icon="arrow-up-right">
                  Live demo
                </Button>
              )}
              {github && (
                <Button href={github} variant="secondary" icon="arrow-up-right">
                  Source on GitHub
                </Button>
              )}
            </dd>
          </div>
        )}
      </dl>
    </header>

    {cover && (
      <div class="container-page pb-12 sm:pb-16">
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 1200px) 1056px, 92vw"
          loading="eager"
          class="border-line w-full rounded-xl border"
        />
      </div>
    )}

    <div class="border-line border-t">
      <div class="container-page grid gap-12 py-14 sm:py-20 lg:grid-cols-12">
        {sections.length > 1 && (
          <aside class="hidden lg:col-span-3 lg:block">
            <nav aria-label="On this page" class="sticky top-28">
              <p class="text-muted font-mono text-xs">On this page</p>
              <ul class="border-line mt-4 space-y-1 border-l">
                {sections.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class="text-muted hover:text-ink hover:border-accent -ml-px block border-l border-transparent py-1.5 pl-4 text-sm transition-colors"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}

        <div class:list={['min-w-0', sections.length > 1 ? 'lg:col-span-8' : 'lg:col-span-12']}>
          {draft && (
            <p
              class="border-muted text-muted mb-12 max-w-[42rem] rounded-lg border border-dashed px-5 py-4 text-[0.9375rem]"
              role="note"
            >
              <strong class="text-ink font-medium">This case study is a work in progress.</strong>{' '}
              The overview below is accurate; architecture details, implementation notes and results
              will be added once they’ve been written up and verified.
            </p>
          )}
          <div class="prose prose-case max-w-[42rem]">
            <slot />
          </div>
        </div>
      </div>
    </div>
  </article>

  <ProjectPager previous={previous} next={next} />
</BaseLayout>
