---
import type { ComponentProps } from 'astro/types';
import '@fontsource-variable/geist/index.css';
import '@fontsource-variable/geist-mono/index.css';
import '@/styles/global.css';

import Seo from '@/components/layout/Seo.astro';
import SideIndex from '@/components/layout/SideIndex.astro';
import Footer from '@/components/layout/Footer.astro';
import { site } from '@/config/site';
import { href, normalizePath } from '@/utils/url';

/** The layout takes exactly the SEO props and forwards them to <Seo>. */
type Props = ComponentProps<typeof Seo>;

const seo = Astro.props;
const isHome = normalizePath(Astro.url.pathname) === '/';
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={site.fullName} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="32x32" href={href('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={href('/favicon-16.png')} />
    <link rel="icon" href={href('/favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <Seo {...seo} />

    <!-- Apply the saved / system theme before first paint to avoid a flash. -->
    <script is:inline>
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          // storage unavailable — fall back to the system preference
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="bg-bg text-ink">
    <a
      href="#main"
      class="bg-ink text-bg sr-only z-[60] rounded-full px-4 py-2 text-sm font-medium focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>

    <!-- overflow-x: clip lets the full-bleed dotted rules run past the column
         without a horizontal scrollbar, and keeps sticky/fixed elements working. -->
    <div class="relative flex min-h-dvh flex-col overflow-x-clip">
      <!-- Vertical dotted lines on the column edges (desktop only). -->
      <div
        aria-hidden="true"
        class="rule-y absolute inset-y-0 hidden md:block"
        style="left: calc(50% - var(--col) / 2)"
      ></div>
      <div
        aria-hidden="true"
        class="rule-y absolute inset-y-0 hidden md:block"
        style="left: calc(50% + var(--col) / 2)"
      ></div>

      {isHome && <SideIndex />}

      <main id="main" class="relative flex-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
