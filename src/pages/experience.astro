---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Timeline from '@/components/sections/Timeline.astro';
import ContactCta from '@/components/sections/ContactCta.astro';
import { getExperience } from '@/utils/content';

const entries = await getExperience();
---

<BaseLayout
  title="Experience"
  description="Professional experience, community roles and open-source involvement of Rishikesh, backend engineer and AI/ML builder."
>
  <PageHeader
    eyebrow="Experience"
    title="Where I’ve worked and contributed."
    intro="Engineering roles first, followed by community and open-source involvement."
  />

  <section class="border-line border-t" aria-label="Experience timeline">
    <div class="container-page py-14 sm:py-20">
      {entries.length > 0 ? (
        <Timeline entries={entries} />
      ) : (
        <p class="text-muted">Experience entries will be added soon.</p>
      )}
    </div>
  </section>

  <ContactCta />
</BaseLayout>
