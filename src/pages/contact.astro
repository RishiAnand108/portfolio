---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import { links } from '@/config/site';
import { href, isExternal } from '@/utils/url';

const handle = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const channels: { label: string; value: string; url: string; icon: IconName; note: string }[] = [
  {
    label: 'Email',
    value: links.email,
    url: links.email ? `mailto:${links.email}` : '',
    icon: 'mail',
    note: 'Best for project enquiries and opportunities.',
  },
  {
    label: 'GitHub',
    value: handle(links.github),
    url: links.github,
    icon: 'github',
    note: 'Code, experiments and open-source work.',
  },
  {
    label: 'LinkedIn',
    value: handle(links.linkedin),
    url: links.linkedin,
    icon: 'linkedin',
    note: 'Professional background and updates.',
  },
  {
    label: 'Resume',
    value: 'Download PDF',
    url: links.resume,
    icon: 'file-text',
    note: 'A one-page summary of my work.',
  },
].filter((c) => c.url) as typeof channels;
---

<BaseLayout
  title="Contact"
  description="Get in touch with Rishikesh about backend engineering, AI/ML projects, internships or collaboration."
>
  <PageHeader
    eyebrow="Contact"
    title="Let’s build something useful."
    intro="I’m happy to talk about backend roles, internships, collaborations or an interesting problem. Email is the most reliable way to reach me."
  />

  <section class="container-page pb-20 sm:pb-28" aria-label="Contact options">
    <ul class="border-line border-t">
      {channels.map((channel) => {
        const external = isExternal(channel.url);
        return (
          <li class="border-line border-b">
            <a
              href={href(channel.url)}
              class="group grid items-center gap-x-6 gap-y-1 py-6 sm:grid-cols-[9rem_1fr_auto] sm:py-8"
              {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="text-muted flex items-center gap-2.5 font-mono text-xs">
                <Icon name={channel.icon} size={16} />
                {channel.label}
              </span>
              <span class="min-w-0">
                <span class="font-display group-hover:text-accent block text-2xl break-words transition-colors sm:text-3xl">
                  {channel.value}
                </span>
                <span class="text-muted mt-1 block text-[0.9375rem]">{channel.note}</span>
              </span>
              <span class="text-muted group-hover:text-accent hidden transition-colors sm:block">
                <Icon name="arrow-up-right" size={22} />
              </span>
              {external && <span class="sr-only">(opens in a new tab)</span>}
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</BaseLayout>
