---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
---

<BaseLayout title="Page not found" description="The page you requested does not exist." noindex>
  <section class="col flex min-h-[60vh] flex-col justify-center pt-24 pb-16">
    <header>
      <p class="text-faint font-mono text-[11px] tracking-[0.2em] uppercase">404 — Not found</p>
      <h1 class="text-ink mt-4 text-[24px] font-bold tracking-tight">
        This route doesn’t return anything.
      </h1>
    </header>
    <p class="text-muted mt-3 max-w-md text-[14px] leading-relaxed">
      The page may have moved, or the link might be wrong. Everything on the site now lives on the
      home page.
    </p>
    <nav aria-label="Where to go next" class="mt-6 flex flex-wrap gap-2">
      <Button href="/" variant="primary" icon="arrow-right">
        Back to home
      </Button>
      <Button href="/#projects">Browse projects</Button>
    </nav>
  </section>
</BaseLayout>
