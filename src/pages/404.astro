---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
---

<BaseLayout title="Page not found" description="The page you requested does not exist." noindex>
  <section class="container-page flex min-h-[65vh] flex-col justify-center py-20">
    <p class="text-muted font-mono text-sm">
      <span class="text-accent">404</span> — Not Found
    </p>
    <h1 class="font-display text-title mt-6 max-w-2xl tracking-[-0.012em] text-balance">
      This route doesn’t return anything.
    </h1>
    <p class="text-muted text-lead mt-6 max-w-xl">
      The page may have moved, or the link might be wrong. The rest of the site is still up.
    </p>
    <div class="mt-10 flex flex-col gap-3 min-[420px]:flex-row">
      <Button href="/" icon="arrow-right">
        Back to home
      </Button>
      <Button href="/projects/" variant="secondary">
        Browse projects
      </Button>
    </div>
  </section>
</BaseLayout>
