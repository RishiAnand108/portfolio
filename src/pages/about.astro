---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import ContactCta from '@/components/sections/ContactCta.astro';
import { aboutIntro, aboutSections, technicalFocus } from '@/config/about';
---

<BaseLayout
  title="About"
  description="About Rishikesh — a backend-focused developer and final-year AI & Data Science student interested in reliable systems, APIs, automation and practical machine learning."
>
  <PageHeader eyebrow="About" title={aboutIntro.title} intro={aboutIntro.lead} />

  <div class="border-line border-t">
    <div class="container-page grid gap-x-10 gap-y-16 py-14 sm:py-20 lg:grid-cols-12">
      <div class="space-y-14 lg:col-span-7">
        {aboutSections.map((section) => (
          <section aria-labelledby={section.id}>
            <h2 id={section.id} class="font-display text-heading tracking-[-0.012em]">
              {section.title}
            </h2>
            <div class="mt-5 max-w-[42rem] space-y-4 text-[1.0625rem] leading-relaxed">
              {section.paragraphs.map((p) => (
                <p class="text-pretty">{p}</p>
              ))}
            </div>
          </section>
        ))}
      </div>

      <aside class="lg:col-span-4 lg:col-start-9" aria-labelledby="focus-heading">
        <div class="lg:sticky lg:top-28">
          <h2 id="focus-heading" class="text-muted font-mono text-xs">
            Technical focus
          </h2>
          <dl class="divide-line border-line mt-4 divide-y border-y">
            {technicalFocus.map((row) => (
              <div class="grid grid-cols-[6.5rem_1fr] gap-4 py-4 text-[0.9375rem]">
                <dt class="text-muted">{row.group}</dt>
                <dd>{row.items.join(', ')}</dd>
              </div>
            ))}
          </dl>

          <h2 class="text-muted mt-10 font-mono text-xs">Elsewhere</h2>
          <SocialLinks class="mt-2 flex-col !items-start" />
        </div>
      </aside>
    </div>
  </div>

  <ContactCta />
</BaseLayout>
