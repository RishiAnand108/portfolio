---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import ProjectList from '@/components/projects/ProjectList.astro';
import { getProjects } from '@/utils/content';

const projects = await getProjects();
---

<BaseLayout
  title="Projects"
  description="Backend engineering, AI/ML and research projects by Rishikesh — each with a case study covering the problem, architecture and technical decisions."
>
  <PageHeader
    eyebrow="Projects"
    title="Things I’ve built, and how they work."
    intro="Backend systems, machine learning work and research. Each project links to a case study that goes into the architecture and the decisions behind it."
  />

  <section class="container-page pb-20 sm:pb-28" aria-label="Project list">
    <ProjectList projects={projects} />
  </section>
</BaseLayout>
